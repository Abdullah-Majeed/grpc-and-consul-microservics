{
  "name": "grpc-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "implicitDependencies": [
    "grpc"
  ],
  "projectType": "application",
  "targets": {
    "e2e": {
      "command": "jest --passWithNoTests",
      "options": {
        "cwd": "apps/grpc-e2e"
      },
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}"
      ],
      "dependsOn": [
        "grpc:build",
        "grpc:serve"
      ]
    }
  }
}
